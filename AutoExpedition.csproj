<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName)</PathMap>
    <EmbedAllSources>true</EmbedAllSources>
    <!-- The HUD sets the output path itself when the source lives in Plugins/Source -->
    <!--
      Optimised whatever the configuration. The HUD builds this project through MSBuild without naming a
      configuration, so it got Debug's defaults and the JIT optimiser switched off: the DLL in Plugins/Temp
      carried DebuggingModes 0x107. Measured offline on one Grand site (2026-09-30): scoring a chain took 174us
      unoptimised against 28us optimised, with identical scores to the last bit.
    -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <!--
      The harness is its own program with its own entry point, and the SDK's glob would otherwise compile it
      into the plugin. Excluded by folder rather than by file, so a second harness source needs no change here.
    -->
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The offline harness under tools/offline references this assembly and calls into the solver, which is
      internal throughout. It compiles none of these sources itself, so there is one implementation of the
      search rather than a copy that can drift. It is a separate build output from the one the HUD compiles
      into Plugins/Temp, so the two can be out of step: a change needs this project built for the harness and
      the plugin reloaded for the game. See tools/offline/OfflineOpenings.csproj.
    -->
    <InternalsVisibleTo Include="OfflineOpenings" />
  </ItemGroup>

  <ItemGroup>
    <!-- Set the exileCore2Package environment variable to your ExileCore2 folder -->
    <Reference Include="ExileCore2">
      <HintPath>$(exileCore2Package)\ExileCore2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GameOffsets2">
      <HintPath>$(exileCore2Package)\GameOffsets2.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      The shipped weight reference table, copied beside the assembly.

      Wrt.Source is DirectoryFullName, which is where the DLL lands - Plugins/Temp - and not the
      source folder this file sits in. Without this the file is version controlled, present, and
      never read: every row shows as unset and the prune that empties a custom file agreeing with
      it never runs. The same rule ExileMaps uses for its own json.
    -->
    <Content Include="weight_reference_table_defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.90.0.1" />
    <!-- The unscouted wash is one generated texture rather than a heap of quads. See Wash. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.3" />
    <!-- For [JsonIgnore] on the settings back-reference; the HUD ships this assembly. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
